#!/usr/bin/env bash
set -euo pipefail

IMAGE="@MAPFGPTDDG_DOCKER_IMAGE@"
REPO_HOST="@MAPFGPTDDG_REPO_HOST_ROOT@"
PY_WORKDIR="/workspace/backend/extern/classical/MAPF-GPT-DDG"

# --- DEBUG: show what we're about to do ---
echo "[wrap] image=${IMAGE}"
echo "[wrap] driver=$1"
echo "[wrap] repo_host=${REPO_HOST}"
echo "[wrap] args: $*"

# First arg is the in-container driver path (we configured it to /workspace/... in CMake)
DRIVER_IN="$1"; shift

# Find --outputPaths to mount its directory
OUT=""
ARGS=("$@")
for i in "${!ARGS[@]}"; do
  if [[ "${ARGS[$i]}" == "--outputPaths" ]]; then
    OUT="${ARGS[$((i+1))]}"
    break
  fi
done
if [[ -z "$OUT" ]]; then
  echo "[mapfgptddg_docker] --outputPaths not provided" >&2
  exit 2
fi
WDIR="$(dirname "$OUT")"
echo "[wrap] wdir_for_output=${WDIR}"

# GPU flag from --device
DEV=""
for i in "${!ARGS[@]}"; do
  if [[ "${ARGS[$i]}" == "--device" ]]; then
    DEV="${ARGS[$((i+1))]}"
    break
  fi
done
GPU_FLAG=""
if [[ "$DEV" == "cuda" ]]; then
  GPU_FLAG="--gpus all"
fi
echo "[wrap] gpu_flag=${GPU_FLAG}"

# (Optional) weights mount disabled — repo is bind-mounted and synced anyway

# Run: mount repo at /workspace, mount temp dir at its absolute path,
# set workdir to the external repo root so `import gpt` works.
exec docker run --rm ${GPU_FLAG} \
  -e PYTHONUNBUFFERED=1 \
  -e PYTHONPATH="${PY_WORKDIR}" \
  -v "${REPO_HOST}":/workspace \
  -v "$WDIR":"$WDIR" \
  -w "${PY_WORKDIR}" \
  "$IMAGE" \
  python -u "$DRIVER_IN" "${ARGS[@]}"